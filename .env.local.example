# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง (.env.local ถูก gitignore แล้ว)

# ── Google OAuth ─────────────────────────────────────────────────────────────
# สร้างที่ https://console.cloud.google.com/apis/credentials
#   1. Create Credentials → OAuth client ID → Web application
#   2. Authorized redirect URI:
#        dev:  http://localhost:3000/api/auth/callback/google
#        prod: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── NextAuth ─────────────────────────────────────────────────────────────────
# สร้าง secret: openssl rand -base64 32
NEXTAUTH_SECRET=
# เว้น NEXTAUTH_URL ว่างไว้ + เปิด AUTH_TRUST_HOST — NextAuth จะเดา URL จาก request header เอง
# (x-forwarded-host / x-forwarded-proto) ใช้ค่าเดียวกันได้ทั้ง local และ prod ไม่ต้องคอยแก้สลับ
# ใช้ได้เพราะ container ไม่เปิด public ตรงๆ (bind 127.0.0.1 เท่านั้น, มี nginx/Caddy อยู่หน้า
# เป็นคนคุม request จริง — ปลอดภัยต่อเมื่อ proxy ตั้ง X-Forwarded-Proto/X-Forwarded-Host ถูกต้อง)
# ถ้าอยาก pin URL ตายตัว (ไม่ auto-detect) ค่อยตั้ง NEXTAUTH_URL=https://<your-domain> เอง
AUTH_TRUST_HOST=true
NEXTAUTH_URL=

# ── App ──────────────────────────────────────────────────────────────────────
# ที่เก็บไฟล์ฐานข้อมูล SQLite — เว้นว่างไว้ = ./seatbooking.db ในโฟลเดอร์โปรเจกต์ (พอสำหรับ dev)
# ⚠️ บน production ต้องตั้งให้อยู่ "นอก" โฟลเดอร์ที่ deploy ทับ เพราะ next build จะก็อป
#    seatbooking.db ติดไปใน .next/standalone/ ด้วย ถ้าปล่อยไว้ในโฟลเดอร์แอป การ deploy รอบถัดไป
#    จะทับข้อมูลการจองจริงด้วย snapshot ตอน build
#    Docker: ตั้งเป็น /data/seatbooking.db แล้ว mount volume ที่ /data (Dockerfile ตั้งค่านี้ให้แล้ว)
#    bare metal: เช่น /var/lib/seatbooking/seatbooking.db (โฟลเดอร์ต้องเขียนได้ เพราะ WAL สร้าง -wal/-shm)
# SEAT_DB_PATH=/data/seatbooking.db
# สวิตช์หลัก: true = เปิด Google login + first-login claim + บังคับ identity ฝั่ง server
#             false/ไม่ตั้ง = โหมดเดิม (เลือกชื่อเองจาก dropdown ไม่ต้อง login)
AUTH_ENABLED=false
# ปิดฟังก์ชันจอง/ปล่อยที่นั่งชั่วคราว (ยังดูผังที่นั่งได้ปกติ) — false = ปิด, true/ไม่ตั้ง = เปิด
BOOKING_ENABLED=false
# จำกัด login เฉพาะ email domain นี้ (ตั้งเป็นค่าว่างเพื่อปิดการจำกัด — dev เท่านั้น)
ALLOWED_EMAIL_DOMAIN=ocean.co.th
# รายชื่อ admin คั่นด้วย comma — ถ้าเว้นว่าง หน้า /admin007 จะเปิดให้ทุกคน (dev เท่านั้น)
ADMIN_EMAILS=chatnarin.ak@ocean.co.th
